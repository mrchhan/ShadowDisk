<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme. -->
  <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F9" />
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PanelAltBrush" Color="#F1F4F9" />
  <SolidColorBrush x:Key="LineBrush" Color="#E2E7F0" />
  <SolidColorBrush x:Key="TextBrush" Color="#111827" />
  <SolidColorBrush x:Key="MutedText" Color="#4B5563" />
  <SolidColorBrush x:Key="HeroTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeroMutedBrush" Color="#B8C4DC" />
  <SolidColorBrush x:Key="AccentBrush" Color="#1D6FE0" />
  <SolidColorBrush x:Key="Accent2Brush" Color="#E56A0E" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE" />
  <SolidColorBrush x:Key="ButtonBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CBD3E1" />
  <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3CBD9" />
  <SolidColorBrush x:Key="UsedBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="FreeBrush" Color="#BFDBFE" />
  <SolidColorBrush x:Key="FreeStrokeBrush" Color="#93C5FD" />
  <SolidColorBrush x:Key="SystemBrush" Color="#9CA3AF" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#F59E0B" />
  <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />
  <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
  <SolidColorBrush x:Key="InfoBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="DangerBackBrush" Color="#FEE2E2" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="#7F1D1D" />
  <SolidColorBrush x:Key="DangerButtonBrush" Color="#B91C1C" />
  <SolidColorBrush x:Key="PreviewBackBrush" Color="#FFFBEB" />
  <SolidColorBrush x:Key="PreviewBorderBrush" Color="#F59E0B" />
  <SolidColorBrush x:Key="PreviewTextBrush" Color="#B45309" />
  <SolidColorBrush x:Key="BannerBackBrush" Color="#FEF3C7" />
  <SolidColorBrush x:Key="BannerLineBrush" Color="#F59E0B" />
  <SolidColorBrush x:Key="BannerTextBrush" Color="#78350F" />
  <SolidColorBrush x:Key="BadgeSafeBrush" Color="#065F46" />
  <SolidColorBrush x:Key="BadgeDangerBrush" Color="#B91C1C" />
  <SolidColorBrush x:Key="BadgeDemoBrush" Color="#B45309" />
  <SolidColorBrush x:Key="ApplyAreaBrush" Color="#F9FAFB" />

  <!-- Hero header background: deep night with a hint of blue. -->
  <LinearGradientBrush x:Key="HeroBackBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#070B16" Offset="0" />
    <GradientStop Color="#0E1A38" Offset="0.55" />
    <GradientStop Color="#1A1424" Offset="1" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="HeroGlowBlue">
    <GradientStop Color="#553BA4FF" Offset="0" />
    <GradientStop Color="#003BA4FF" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="HeroGlowOrange">
    <GradientStop Color="#44FF8A2A" Offset="0" />
    <GradientStop Color="#00FF8A2A" Offset="1" />
  </RadialGradientBrush>
  <!-- The AIShadow colours: electric blue to ember orange. -->
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#2F8CFF" Offset="0" />
    <GradientStop Color="#7A6BFF" Offset="0.5" />
    <GradientStop Color="#FF8A2A" Offset="1" />
  </LinearGradientBrush>
  <DrawingBrush x:Key="UnallocatedBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 L8,0 8,8 0,8Z" />
        <GeometryDrawing Geometry="M0,8 L8,0">
          <GeometryDrawing.Pen><Pen Brush="#6B7280" Thickness="1.2" /></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
