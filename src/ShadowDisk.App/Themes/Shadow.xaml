<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shadow theme (default): night blue with the AIShadow electric blue and ember orange. -->
  <SolidColorBrush x:Key="WindowBrush" Color="#0A0F1E" />
  <SolidColorBrush x:Key="PanelBrush" Color="#111A2E" />
  <SolidColorBrush x:Key="PanelAltBrush" Color="#172340" />
  <SolidColorBrush x:Key="LineBrush" Color="#25365A" />
  <SolidColorBrush x:Key="TextBrush" Color="#E6EBF5" />
  <SolidColorBrush x:Key="MutedText" Color="#94A3B8" />
  <SolidColorBrush x:Key="HeroTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeroMutedBrush" Color="#A9B8D6" />
  <SolidColorBrush x:Key="AccentBrush" Color="#3BA4FF" />
  <SolidColorBrush x:Key="Accent2Brush" Color="#FF8A2A" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#1C3A68" />
  <SolidColorBrush x:Key="ButtonBrush" Color="#18233D" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2B3E66" />
  <SolidColorBrush x:Key="InputBrush" Color="#0C1426" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33466E" />
  <LinearGradientBrush x:Key="UsedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#6CC3FF" Offset="0" />
    <GradientStop Color="#3B8BFF" Offset="0.45" />
    <GradientStop Color="#5B4BE0" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="FreeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#274C80" Offset="0" />
    <GradientStop Color="#1B365F" Offset="0.5" />
    <GradientStop Color="#152A4C" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="FreeStrokeBrush" Color="#3A5F94" />
  <LinearGradientBrush x:Key="SystemBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#7D8AA6" Offset="0" />
    <GradientStop Color="#5A6680" Offset="0.5" />
    <GradientStop Color="#454F66" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SelectionBrush" Color="#FF8A2A" />
  <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
  <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA" />
  <SolidColorBrush x:Key="DangerBackBrush" Color="#3A1519" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="#FECACA" />
  <SolidColorBrush x:Key="DangerButtonBrush" Color="#C42B2B" />
  <SolidColorBrush x:Key="PreviewBackBrush" Color="#24170C" />
  <SolidColorBrush x:Key="PreviewBorderBrush" Color="#FF8A2A" />
  <SolidColorBrush x:Key="PreviewTextBrush" Color="#FDBA74" />
  <SolidColorBrush x:Key="BannerBackBrush" Color="#33260A" />
  <SolidColorBrush x:Key="BannerLineBrush" Color="#B7791F" />
  <SolidColorBrush x:Key="BannerTextBrush" Color="#FDE68A" />
  <SolidColorBrush x:Key="BadgeSafeBrush" Color="#0E5C46" />
  <SolidColorBrush x:Key="BadgeDangerBrush" Color="#B91C1C" />
  <SolidColorBrush x:Key="BadgeDemoBrush" Color="#A35A0B" />
  <SolidColorBrush x:Key="ApplyAreaBrush" Color="#0E1730" />

  <!-- Hero header background: deep night with a hint of blue. -->
  <LinearGradientBrush x:Key="HeroBackBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#05080F" Offset="0" />
    <GradientStop Color="#0B1530" Offset="0.55" />
    <GradientStop Color="#140F1E" Offset="1" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="HeroGlowBlue">
    <GradientStop Color="#663BA4FF" Offset="0" />
    <GradientStop Color="#003BA4FF" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="HeroGlowOrange">
    <GradientStop Color="#55FF8A2A" Offset="0" />
    <GradientStop Color="#00FF8A2A" Offset="1" />
  </RadialGradientBrush>
  <!-- The AIShadow colours: electric blue to ember orange. -->
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#2F8CFF" Offset="0" />
    <GradientStop Color="#7A6BFF" Offset="0.5" />
    <GradientStop Color="#FF8A2A" Offset="1" />
  </LinearGradientBrush>
  <DrawingBrush x:Key="UnallocatedBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#0C1426" Geometry="M0,0 L8,0 8,8 0,8Z" />
        <GeometryDrawing Geometry="M0,8 L8,0">
          <GeometryDrawing.Pen><Pen Brush="#5A4FB0" Thickness="1.2" /></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
