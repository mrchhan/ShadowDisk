<Window x:Class="ShadowDisk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ShadowDisk.App.ViewModels"
        xmlns:c="clr-namespace:ShadowDisk.App.Controls"
        Title="{Binding WindowTitle}"
        Width="1240" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/shadowdisk.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Window.Resources>
    <!-- Hero motion: slow aurora glows, a breathing glow on the icons and a shimmer along the accent line.
         Started from code only when Windows' "Show animations" setting is on. -->
    <Storyboard x:Key="HeroMotion">
      <DoubleAnimation Storyboard.TargetName="GlowBlueShift" Storyboard.TargetProperty="X" From="-40" To="110" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="GlowBlueShift" Storyboard.TargetProperty="Y" From="-14" To="16" Duration="0:0:7" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="GlowOrangeShift" Storyboard.TargetProperty="X" From="50" To="-110" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="GlowOrangeShift" Storyboard.TargetProperty="Y" From="12" To="-12" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="AppGlow" Storyboard.TargetProperty="BlurRadius" From="8" To="24" Duration="0:0:2.6" AutoReverse="True" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetName="AppGlow" Storyboard.TargetProperty="Opacity" From="0.45" To="0.95" Duration="0:0:2.6" AutoReverse="True" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="BlurRadius" From="6" To="20" Duration="0:0:3.2" AutoReverse="True" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetName="ShimmerShift" Storyboard.TargetProperty="X" From="-220" To="2400" Duration="0:0:5" RepeatBehavior="Forever" />
      <!-- Rings orbiting the disk icon, like a disk spinning. -->
      <DoubleAnimation Storyboard.TargetName="RingSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetName="RingSpinSlow" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:14" RepeatBehavior="Forever" />
      <!-- A shine sweeping across the title every few seconds. -->
      <ParallelTimeline Duration="0:0:6" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetName="TitleShineA" Storyboard.TargetProperty="Offset" From="-0.4" To="1.0" Duration="0:0:1.6" />
        <DoubleAnimation Storyboard.TargetName="TitleShineB" Storyboard.TargetProperty="Offset" From="-0.2" To="1.2" Duration="0:0:1.6" />
        <DoubleAnimation Storyboard.TargetName="TitleShineC" Storyboard.TargetProperty="Offset" From="0.0" To="1.4" Duration="0:0:1.6" />
      </ParallelTimeline>
      <!-- The plan preview breathes with an orange glow. -->
      <DoubleAnimation Storyboard.TargetName="PreviewGlowBar" Storyboard.TargetProperty="BlurRadius" From="4" To="18" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" />
      <DoubleAnimation Storyboard.TargetName="PreviewGlowPie" Storyboard.TargetProperty="BlurRadius" From="4" To="18" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" />
    </Storyboard>
  </Window.Resources>

  <DockPanel>
    <!-- ===== Hero header ===== -->
    <Grid DockPanel.Dock="Top" Height="76" ClipToBounds="True" Background="{DynamicResource HeroBackBrush}">
      <Ellipse Width="480" Height="250" Fill="{DynamicResource HeroGlowBlue}" HorizontalAlignment="Left" VerticalAlignment="Center"
               Margin="-140,0,0,0" IsHitTestVisible="False">
        <Ellipse.RenderTransform><TranslateTransform x:Name="GlowBlueShift" /></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="480" Height="250" Fill="{DynamicResource HeroGlowOrange}" HorizontalAlignment="Right" VerticalAlignment="Center"
               Margin="0,0,-150,0" IsHitTestVisible="False">
        <Ellipse.RenderTransform><TranslateTransform x:Name="GlowOrangeShift" /></Ellipse.RenderTransform>
      </Ellipse>

      <DockPanel Margin="20,0,16,2">
        <StackPanel x:Name="HeroLeft" Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Grid Width="56" Height="56">
            <!-- Fast gradient ring and a slow dashed ring orbit the icon. -->
            <Ellipse Width="54" Height="54" StrokeThickness="2" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
              <Ellipse.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FF3BA4FF" Offset="0" />
                  <GradientStop Color="#003BA4FF" Offset="0.45" />
                  <GradientStop Color="#00FF8A2A" Offset="0.55" />
                  <GradientStop Color="#FFFF8A2A" Offset="1" />
                </LinearGradientBrush>
              </Ellipse.Stroke>
              <Ellipse.RenderTransform><RotateTransform x:Name="RingSpin" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="48" Height="48" Stroke="#553BA4FF" StrokeThickness="1" StrokeDashArray="2 4" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
              <Ellipse.RenderTransform><RotateTransform x:Name="RingSpinSlow" /></Ellipse.RenderTransform>
            </Ellipse>
            <!-- A real-looking hard disk: turns slowly, spins up with the arm seeking whenever ShadowDisk is working. -->
            <c:SpinningDisk Width="38" Height="38" IsBusy="{Binding IsBusy}" FollowsActivity="True">
              <c:SpinningDisk.Effect><DropShadowEffect x:Name="AppGlow" Color="#3BA4FF" ShadowDepth="0" BlurRadius="14" Opacity="0.7" /></c:SpinningDisk.Effect>
            </c:SpinningDisk>
          </Grid>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="ShadowDisk" FontSize="24" FontWeight="Bold">
              <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#FFFFFFFF" Offset="0" />
                  <GradientStop x:Name="TitleShineA" Color="#FFFFFFFF" Offset="-0.4" />
                  <GradientStop x:Name="TitleShineB" Color="#FF8FD0FF" Offset="-0.2" />
                  <GradientStop x:Name="TitleShineC" Color="#FFFFFFFF" Offset="0.0" />
                  <GradientStop Color="#FFFFFFFF" Offset="1" />
                </LinearGradientBrush>
              </TextBlock.Foreground>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{DynamicResource HeroMutedBrush}">
              <Run Text="Disk &amp; partition manager · v" /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · your data comes first" />
            </TextBlock>
          </StackPanel>
          <Border Width="1" Height="36" Background="#33FFFFFF" Margin="18,0,16,0" />
          <Ellipse Width="34" Height="34" AutomationProperties.Name="AIShadow logo">
            <Ellipse.Fill><ImageBrush ImageSource="Assets/aishadow-logo.png" RenderOptions.BitmapScalingMode="HighQuality" /></Ellipse.Fill>
            <Ellipse.Effect><DropShadowEffect x:Name="LogoGlow" Color="#FF8A2A" ShadowDepth="0" BlurRadius="12" Opacity="0.65" /></Ellipse.Effect>
          </Ellipse>
          <TextBlock Text="by AIShadow" Foreground="{DynamicResource HeroMutedBrush}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="HeroRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Style="{StaticResource Badge}" Background="{DynamicResource BadgeDemoBrush}"
                  Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="●  DEMO — SIMULATED DISKS" Foreground="White" FontWeight="Bold" FontSize="12" />
          </Border>
          <Border Style="{StaticResource Badge}" Background="{DynamicResource BadgeSafeBrush}"
                  ToolTip="{Binding ReadOnlyStatement}"
                  Visibility="{Binding RealDiskChangesEnabled, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="●  PHYSICAL DISKS READ-ONLY — changes only on practice disks" Foreground="White" FontWeight="SemiBold" FontSize="12" />
          </Border>
          <Border Style="{StaticResource Badge}" Background="{DynamicResource BadgeDangerBrush}"
                  ToolTip="Changes to real data volumes are allowed in this session. C: may only be extended; system partitions stay protected."
                  Visibility="{Binding RealDiskChangesEnabled, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="●  REAL DISK CHANGES ON — back up first" Foreground="White" FontWeight="Bold" FontSize="12" />
          </Border>
        </StackPanel>
      </DockPanel>

      <!-- Accent line in the AIShadow colours, with a light shimmer running along it. -->
      <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource AccentGradient}" IsHitTestVisible="False" />
      <Rectangle Width="200" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#DDFFFFFF" Offset="0.5" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
        <Rectangle.RenderTransform><TranslateTransform x:Name="ShimmerShift" X="-220" /></Rectangle.RenderTransform>
      </Rectangle>
    </Grid>

    <!-- ===== Toolbar (grouped: view · tools · practice · real changes · app) ===== -->
    <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8,14,4">
      <WrapPanel VerticalAlignment="Center">
        <Button Content="_Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh disk information" Margin="0,0,10,4" />
        <TextBlock Text="Source" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,4" />
        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding Source}" Width="190" Margin="0,0,10,4"
                  AutomationProperties.Name="Data source" />
        <TextBlock Text="View" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,4" />
        <ComboBox ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding View}" Width="100" Margin="0,0,4,4"
                  AutomationProperties.Name="Visualization style" />
        <Border Style="{StaticResource ToolbarDivider}" />

        <Button Content="Disk health…" Command="{Binding DiskHealthCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,4"
                ToolTip="What the selected drive reports about its health, and an optional read-only surface scan for bad sectors." />
        <Button Content="Copy &amp; verify…" Command="{Binding OpenCopyVerifyCommand}" Margin="0,0,6,4"
                ToolTip="Copy a drive's files into a new folder on another drive and check every file's checksum. Never deletes anything." />
        <Button Content="_Export report…" Command="{Binding ExportReportCommand}" Margin="0,0,6,4" />
        <Button Content="Disk Management" Command="{Binding OpenDiskManagementCommand}" Margin="0,0,0,4"
                ToolTip="Open Windows Disk Management." />
        <Border Style="{StaticResource ToolbarDivider}" />

        <Button Content="New practice disk" Command="{Binding CreatePracticeDiskCommand}" Margin="0,0,6,4"
                ToolTip="Creates a virtual disk file for safely trying real changes. Needs administrator rights." />
        <Button Content="Remove practice disks" Command="{Binding RemovePracticeDisksCommand}" Margin="0,0,0,4"
                ToolTip="Detaches and deletes ShadowDisk's practice disk files." />
        <Border Style="{StaticResource ToolbarDivider}" />

        <Button Content="{Binding RealDiskButtonText}" Command="{Binding ToggleRealDiskChangesCommand}" Margin="0,0,6,4"
                ToolTip="Allows changes to data volumes on real disks for this session only. Needs administrator rights." />
        <Button Content="Restart as administrator" Command="{Binding RestartElevatedCommand}" Margin="0,0,0,4"
                ToolTip="Needed for real changes, practice disks, health counters and scans. Still read-only until you choose a change."
                Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVis}}" />
        <Border Style="{StaticResource ToolbarDivider}" />

        <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" Margin="0,0,6,4"
                ToolTip="Switch between the Shadow (dark) and Light themes. Remembered for next time." />
        <Button Content="Log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,0,4" />
      </WrapPanel>
    </Border>

    <!-- ===== Banner for warnings / demo mode / errors ===== -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource BannerBackBrush}" BorderBrush="{DynamicResource BannerLineBrush}" BorderThickness="0,0,0,1" Padding="16,7"
            Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" Foreground="{DynamicResource BannerTextBrush}" />
    </Border>

    <!-- ===== Status bar ===== -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal">
          <c:SpinningDisk Width="16" Height="16" Margin="0,0,8,0" IsSpinning="False" IsBusy="{Binding IsBusy}" FollowsActivity="True" />
          <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" VerticalAlignment="Center" />
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <!-- ===== Log ===== -->
    <Expander DockPanel.Dock="Bottom" Header="Activity log" Margin="14,0,14,6" IsExpanded="False">
      <ListBox ItemsSource="{Binding LogEntries}" Height="130" FontFamily="Consolas" FontSize="12" Background="{DynamicResource PanelBrush}"
               AutomationProperties.Name="Activity log" />
    </Expander>

    <Grid Margin="14,14,14,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ===== Disk list ===== -->
      <Border x:Name="DiskListCard" Style="{StaticResource Card}" Margin="0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="PHYSICAL DISKS" Foreground="{DynamicResource MutedText}" FontSize="11" FontWeight="Bold" Margin="8,2,0,10" />
          <ListBox x:Name="DiskList" ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" BorderThickness="0"
                   AutomationProperties.Name="Physical disks" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DiskItemViewModel}">
                <DockPanel Margin="4,8" AutomationProperties.Name="{Binding Title}">
                  <!-- Each disk's platter; the selected disk's platter turns. -->
                  <c:SpinningDisk DockPanel.Dock="Left" Width="28" Height="28" VerticalAlignment="Top" Margin="0,2,10,0" FollowsActivity="False"
                                  IsSpinning="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedText}" />
                    <TextBlock Text="{Binding Badges}" Foreground="{DynamicResource WarningBrush}" FontSize="12" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ===== Selected disk ===== -->
      <ScrollViewer x:Name="Details" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasDisk, Converter={StaticResource BoolToVis}}">
        <StackPanel x:Name="DetailsPanel" DataContext="{Binding SelectedDisk}">

          <!-- Identity -->
          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Grid.ColumnSpan="4" Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Text="Size" Foreground="{DynamicResource MutedText}" Margin="0,0,10,2" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="Partition style" Foreground="{DynamicResource MutedText}" Margin="16,0,10,2" />
              <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding StyleText}" />
              <TextBlock Grid.Row="2" Text="Connection" Foreground="{DynamicResource MutedText}" Margin="0,0,10,2" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BusDisplay}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="Sectors" Foreground="{DynamicResource MutedText}" Margin="16,0,10,2" />
              <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SectorText}" />
              <TextBlock Grid.Row="3" Text="Serial" Foreground="{DynamicResource MutedText}" Margin="0,0,10,2" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SerialText}" />
              <TextBlock Grid.Row="3" Grid.Column="2" Text="Windows-reported health" Foreground="{DynamicResource MutedText}" Margin="16,0,10,2"
                         ToolTip="This is the status Windows reports for the drive. It is not a bad-sector or surface scan and does not prove the disk is safe." />
              <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding HealthText}" FontWeight="SemiBold" />
            </Grid>
          </Border>

          <!-- Space summary + chart -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Space on this disk" Style="{StaticResource SectionTitle}" />
              <WrapPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                  <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource UsedBrush}" Margin="0,0,6,0" />
                  <TextBlock><Run Text="Used data: " /><Run Text="{Binding UsedText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                  <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource FreeBrush}" Stroke="{DynamicResource FreeStrokeBrush}" Margin="0,0,6,0" />
                  <TextBlock><Run Text="Free inside volumes: " /><Run Text="{Binding FreeText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                  <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource SystemBrush}" Margin="0,0,6,0" />
                  <TextBlock Text="System / reserved partitions" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                  <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource UnallocatedBrush}" Stroke="{DynamicResource LineBrush}" Margin="0,0,6,0" />
                  <TextBlock><Run Text="Unallocated (no partition): " /><Run Text="{Binding UnallocatedText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                </StackPanel>
              </WrapPanel>

              <c:DiskBarView Layout="{Binding Layout}"
                             SelectedRegion="{Binding DataContext.SelectedRegion, RelativeSource={RelativeSource AncestorType=Window}}"
                             BoundaryDragCommand="{Binding DataContext.BoundaryDragCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             Visibility="{Binding DataContext.ShowBar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.HelpText="Disk layout bar. Use the partition table below for exact values." />

              <c:DiskPieView Layout="{Binding Layout}" HorizontalAlignment="Left"
                             SelectedRegion="{Binding DataContext.SelectedRegion, RelativeSource={RelativeSource AncestorType=Window}}"
                             Visibility="{Binding DataContext.ShowPie, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.HelpText="Disk layout donut chart. Use the partition table below for exact values." />

              <TextBlock Text="Click a block or slice to select it. In Bar view, drag the line between two drives to move space between them: a wizard opens with that amount and nothing changes until you confirm. Very small partitions are drawn slightly larger than scale; the table below shows exact sizes."
                         Foreground="{DynamicResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <!-- Table (always shown: the textual alternative to the charts) -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Partitions and unallocated space (disk order)" Style="{StaticResource SectionTitle}" />
              <DataGrid ItemsSource="{Binding Rows}"
                        SelectedItem="{Binding DataContext.SelectedRow, RelativeSource={RelativeSource AncestorType=Window}}"
                        AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                        HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                        BorderThickness="0" RowHeight="30" ColumnHeaderHeight="32"
                        AutomationProperties.Name="Partition table">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                  <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="2*" />
                  <DataGridTextColumn Header="File system" Binding="{Binding FileSystem}" Width="*" />
                  <DataGridTextColumn Header="Starts at" Binding="{Binding Start}" Width="*" />
                  <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*" />
                  <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="*" />
                  <DataGridTextColumn Header="Free" Binding="{Binding Free}" Width="*" />
                  <DataGridTextColumn Header="Encryption" Binding="{Binding Encryption}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <!-- Plan a change: PREVIEW ONLY. Nothing in this card can change a disk. -->
          <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1.5"
                  DataContext="{Binding DataContext.Plan, RelativeSource={RelativeSource AncestorType=Window}}"
                  Visibility="{Binding DataContext.HasPlanPanel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Border DockPanel.Dock="Right" Background="{DynamicResource PreviewBackBrush}" BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                  <TextBlock Text="PREVIEW ONLY — nothing is applied to your disk" Foreground="{DynamicResource PreviewTextBrush}" FontWeight="SemiBold" FontSize="12" />
                </Border>
                <TextBlock Text="Plan a change" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
              </DockPanel>

              <TextBlock Text="{Binding NothingToPlanText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"
                         Visibility="{Binding CanPlan, Converter={StaticResource InverseBoolToVis}}" />

              <StackPanel Visibility="{Binding CanPlan, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Change:" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Label"
                            Width="260" AutomationProperties.Name="Planned change" />
                  <TextBlock Text="Choose a change to preview" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"
                             Visibility="{Binding HasOption, Converter={StaticResource InverseBoolToVis}}" />
                  <TextBlock Text="Asking Windows for the size limits… this can take a minute on large drives." Foreground="{DynamicResource MutedText}"
                             VerticalAlignment="Center" Margin="10,0,0,0"
                             Visibility="{Binding IsLoadingLimits, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBlock Text="{Binding ExtendBlockedText}" TextWrapping="Wrap" Foreground="{DynamicResource PreviewTextBrush}" Margin="0,0,0,8">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <Trigger Property="Text" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <StackPanel Visibility="{Binding HasOption, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding LimitsText}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding LimitsNote}" Foreground="{DynamicResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8" />

                  <StackPanel Visibility="{Binding HasUsableLimits, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <TextBlock Text="New size (GiB):" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBox Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="110" Padding="4,3"
                               AutomationProperties.Name="New size in GiB" />
                      <Button Content="Minimum" Command="{Binding UseMinimumCommand}" Margin="8,0,6,0" />
                      <Button Content="Maximum" Command="{Binding UseMaximumCommand}" />
                    </StackPanel>
                    <Slider Minimum="{Binding SliderMinimum}" Maximum="{Binding SliderMaximum}" Value="{Binding SliderValue}"
                            SmallChange="1" LargeChange="1024" IsMoveToPointEnabled="True" Margin="0,0,0,10"
                            AutomationProperties.Name="New size slider" />
                  </StackPanel>

                  <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictColor}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,10" />

                  <!-- Current vs proposed -->
                  <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                    <!-- Pie view: current and proposed side by side -->
                    <Grid Visibility="{Binding DataContext.ShowPie, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Current layout" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <c:DiskPieView Layout="{Binding CurrentLayout}" IsSelectable="False" HorizontalAlignment="Center"
                                       SelectedRegion="{Binding DataContext.SelectedRegion, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                      </StackPanel>
                      <Border Grid.Column="2" BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="2" CornerRadius="8" Padding="6" Background="{DynamicResource PreviewBackBrush}">
                        <Border.Effect><DropShadowEffect x:Name="PreviewGlowPie" Color="#FF8A2A" ShadowDepth="0" BlurRadius="8" Opacity="0.55" /></Border.Effect>
                        <StackPanel>
                          <TextBlock Text="Proposed — PREVIEW ONLY, NOT APPLIED" FontWeight="Bold" Foreground="{DynamicResource PreviewTextBrush}" Margin="0,0,0,4" />
                          <c:DiskPieView Layout="{Binding ProposedLayout}" SelectedRegion="{Binding ProposedRegion, Mode=OneWay}" IsSelectable="False"
                                         HorizontalAlignment="Center" AutomationProperties.HelpText="Proposed layout preview. Nothing has been changed." />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- Bar and table views: current above proposed -->
                    <StackPanel Visibility="{Binding DataContext.ShowPie, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="Current layout" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <c:DiskBarView Layout="{Binding CurrentLayout}" IsSelectable="False"
                                   HighlightStart="{Binding HighlightStart}" HighlightLength="{Binding HighlightLength}" />
                    <TextBlock Text="Proposed layout — PREVIEW ONLY, NOT APPLIED" FontWeight="Bold" Foreground="{DynamicResource PreviewTextBrush}" Margin="0,8,0,4" />
                    <Border BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="2" CornerRadius="8" Padding="4" Background="{DynamicResource PreviewBackBrush}">
                      <Border.Effect><DropShadowEffect x:Name="PreviewGlowBar" Color="#FF8A2A" ShadowDepth="0" BlurRadius="8" Opacity="0.55" /></Border.Effect>
                      <c:DiskBarView Layout="{Binding ProposedLayout}" IsSelectable="False"
                                     HighlightStart="{Binding HighlightStart}" HighlightLength="{Binding HighlightLength}"
                                     HandleOffset="{Binding HandleOffset}" HandleDragCommand="{Binding HandleDragCommand}"
                                     AutomationProperties.HelpText="Proposed layout preview with a drag handle for the size. Nothing has been changed." />
                    </Border>
                    <TextBlock Text="Drag the orange handle on the proposed bar to change the size, or use the box and slider above."
                               Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ExplainChangeText}" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Text="Checks" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                  <ItemsControl ItemsSource="{Binding Checks}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:PlanCheckViewModel}">
                        <DockPanel Margin="0,1">
                          <TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" FontWeight="Bold" Width="18" />
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="Risks of doing this for real" FontWeight="SemiBold" Margin="0,0,0,4"
                             Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                  <ItemsControl ItemsSource="{Binding Risks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,1" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Stage 3: apply for real (practice disks, create volume, administrator only) -->
                  <Border Visibility="{Binding ShowApplyArea, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ApplyAreaBrush}"
                          BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                      <TextBlock Text="Apply for real" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <TextBlock Text="{Binding ApplyBlockedReason}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"
                                 Visibility="{Binding CanApply, Converter={StaticResource InverseBoolToVis}}" />
                      <StackPanel Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding ApplyIntroText}" />
                        <Button Content="{Binding ApplyButtonText}" Command="{Binding ApplyCommand}" HorizontalAlignment="Left"
                                Style="{StaticResource DangerButton}" Margin="0,8,0,0" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Selected region details -->
          <Border Style="{StaticResource Card}"
                  DataContext="{Binding DataContext.SelectedRow, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}">
                <Run Text="Selected: " /><Run Text="{Binding Name, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Foreground="{DynamicResource MutedText}" Margin="0,0,0,8">
                <Run Text="{Binding Type, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeExact, Mode=OneWay}" />
              </TextBlock>

              <ItemsControl ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:NoticeViewModel}">
                    <StackPanel Margin="0,0,0,6">
                      <TextBlock FontWeight="SemiBold" Foreground="{Binding Color}">
                        <Run Text="{Binding Severity, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Title, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Stage 5 part 2: volume actions (real disks need "Real disk changes: ON"; system partitions refused) -->
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                          Visibility="{Binding DataContext.HasVolumeActions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Button Content="Change drive letter…" Command="{Binding DataContext.ChangeLetterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Give this volume a different drive letter. Files are not touched." />
                <Button Content="Give space from the next volume…" Command="{Binding DataContext.GiveSpaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource AccentButton}"
                        ToolTip="Moves the next volume's files further along the disk (verified copy) and gives the freed space to this volume." />
                <Button Content="Delete this volume…" Command="{Binding DataContext.DeleteVolumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource DangerTextButton}"
                        ToolTip="Only allowed for an empty volume, or one whose files were copied and verified with “Copy &amp; verify” in this session." />
              </StackPanel>
              <TextBlock Text="Basic checks for possible changes"
                         FontWeight="SemiBold" Margin="0,8,0,4" />
              <ItemsControl ItemsSource="{Binding Assessments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:AssessmentViewModel}">
                    <StackPanel Margin="0,0,0,6">
                      <TextBlock><Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Verdict, Mode=OneWay}" /></TextBlock>
                      <ItemsControl ItemsSource="{Binding Reasons}" Margin="14,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Disk-level notices -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Safety notes for this disk" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="No notes for this disk." Foreground="{DynamicResource MutedText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Notices.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Notices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:NoticeViewModel}">
                    <StackPanel Margin="0,0,0,6">
                      <TextBlock FontWeight="SemiBold" Foreground="{Binding Color}">
                        <Run Text="{Binding Scope, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Severity, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Title, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,8,0,0"
                         Text="About health: the status above is what Windows reports, not a bad-sector scan. Use “Disk health…” for the drive's own counters and an optional read-only surface scan." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
