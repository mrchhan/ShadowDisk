<Application x:Class="ShadowDisk.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ShadowDisk.App.Controls"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Index 0 is the colour theme. Theme.Set swaps it (Shadow or Light). -->
        <ResourceDictionary Source="Themes/Shadow.xaml" />
        <ResourceDictionary Source="Themes/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
